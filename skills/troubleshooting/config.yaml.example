# 提交到库的案例模板；真实连接信息写到同目录的 config.yaml（不入库，权限 600）。
# conn 地址：public-ip 与 private-ip 至少一个必填；配了 public-ip 就优先走公网。
# 密码只写本地 config.yaml，按敏感数据对待，切勿提交。
conn:
  public-ip: xx.xx.xx.xx        # 跳板机公网地址；配了即优先走公网（代表本机不能直连私网）
  public-port: 22               # 公网地址的 ssh 端口（只作用于公网链路；私网固定 22）
  private-ip: xx.xx.xx.xx       # 跳板机私网地址；纯内网可把 public-ip 也填成该内网地址
  sshpassword:                  # host 通道连非集群机器的共享密码列表，按顺序逐个尝试
    - '密码1'
    - '密码2'

codehub:                        # 本地代码库：组件别名 -> 本地仓库路径（查最新代码用）
  components-1: ~/work/xxx
  components-2: ~/work/yyy

worktree:
  workdir: ~/work/worktree      # 客户报版本时，只读 worktree 的工作目录

troubleshooting-knowledge: ~/skills/troubleshooting-knowledge   # 知识库 skill 目录（可选；河道取水，按 expand 规则展开路径）
